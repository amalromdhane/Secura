}
.blk-warning > p { color: #d4b483; margin: 0; }

/* 🚫 Danger — rouge */
.blk-danger {
  background: rgba(255, 71, 87, 0.07);
  border-left: 4px solid #ff4757;
  border-top: none; border-right: none; border-bottom: none;
  border-radius: 0 12px 12px 0;
  padding: 14px 18px;
  margin: 12px 0;
  display: block;
}
.blk-danger > strong {
  display: block;
  color: #ff6b7a;
  font-size: 0.93rem;
