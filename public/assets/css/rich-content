.blk-info > p { color: #93b8f5; margin: 0; }

/* ================================================================
   📊 TABLEAUX  .comparison-table
================================================================ */
table.comparison-table {
  width: 100%;
  border-collapse: collapse;
  margin: 16px 0;
  font-size: 13px;
  display: table;
  border-radius: 10px;
  overflow: hidden;
  border: 1px solid rgba(0, 212, 255, 0.15);
}
table.comparison-table thead {
  background: linear-gradient(135deg, rgba(13,110,253,0.35), rgba(0,212,255,0.15));
}
table.comparison-table th {
  padding: 11px 14px;
  text-align: left;
  font-weight: 700;
  color: #e2e8f0;
  border: 1px solid rgba(0, 212, 255, 0.12);
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.4px;
}
table.comparison-table td {
  padding: 10px 14px;
  border: 1px solid rgba(255, 255, 255, 0.05);
  vertical-align: top;
  color: #c9d1d9;
}
table.comparison-table tr:nth-child(even) td {
  background: rgba(255, 255, 255, 0.03);
}
table.comparison-table tbody tr:hover td {
  background: rgba(0, 212, 255, 0.06);
  transition: background 0.15s;
}
@media (max-width: 600px) {
  table.comparison-table { display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; }
}

/* ================================================================
   🔢 RÈGLE 3-2-1  .blk-321
================================================================ */
.blk-321 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin: 16px 0;
  text-align: center;
}
.blk-321-item {
  background: rgba(13, 110, 253, 0.08);
  border: 1px solid rgba(0, 212, 255, 0.2);
  border-radius: 12px;
  padding: 22px 14px;
  display: block;
  transition: transform 0.22s, box-shadow 0.22s;
}
.blk-321-item:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 26px rgba(0, 212, 255, 0.15);
}
.blk-321-num {
  font-size: 2.8rem;
  font-weight: 900;
  color: #00d4ff;
  line-height: 1;
  text-shadow: 0 0 20px rgba(0, 212, 255, 0.45);
  display: block;
}
.blk-321-label {
  font-size: 0.76rem;
  color: #8896a7;
  margin-top: 9px;
  line-height: 1.45;
  display: block;
}
@media (max-width: 600px) {
  .blk-321 { grid-template-columns: 1fr; }
}

/* ================================================================
   👣 ÉTAPES  .blk-steps / .blk-step
   Miroir dark des cards à numéro bleu de l'éditeur
================================================================ */
.blk-steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin: 16px 0;
}
.blk-step {
  background: rgba(13, 110, 253, 0.07);
  border: 1px solid rgba(13, 110, 253, 0.22);
  border-radius: 12px;
  padding: 20px 14px;
  text-align: center;
  display: block;
  transition: transform 0.22s, box-shadow 0.22s;
}
.blk-step:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 26px rgba(0, 212, 255, 0.12);
}
.blk-step-num {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: linear-gradient(135deg, #0d6efd, #00aaff);
  color: #fff;
  font-weight: 800;
  font-size: 1.05rem;
  margin-bottom: 12px;
  box-shadow: 0 4px 14px rgba(13, 110, 253, 0.45);
}
.blk-step-title {
  font-weight: 700;
  color: #e2e8f0;
  margin-bottom: 6px;
  font-size: 0.9rem;
  display: block;
}
.blk-step-desc {
  font-size: 0.78rem;
  color: #8896a7;
  line-height: 1.5;
  display: block;
}
@media (max-width: 768px) {
  .blk-steps { grid-template-columns: 1fr; }
}

/* ================================================================
   🔖 SÉPARATEUR DE CHAPITRE
================================================================ */
.chapter-divider {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 22px;
}
.chapter-divider-badge {
  background: linear-gradient(135deg, #0d6efd, #00d4ff);
  color: #fff;
  font-size: 0.7rem;
  font-weight: 700;
  padding: 5px 15px;
  border-radius: 20px;
  white-space: nowrap;
  letter-spacing: 0.6px;
  text-transform: uppercase;
  box-shadow: 0 4px 12px rgba(0, 212, 255, 0.28);
}
.chapter-divider-line {
  flex: 1;
  height: 1px;
  background: linear-gradient(90deg, rgba(0,212,255,0.35), transparent);
}