.blk-tip {
  background: rgba(32, 201, 151, 0.07);
  border-left: 4px solid #20c997;
  border-top: none; border-right: none; border-bottom: none;
  border-radius: 0 12px 12px 0;
  padding: 14px 18px;
  margin: 12px 0;
  display: block;
}
.blk-tip > strong {
  display: block;
  color: #20c997;
  font-size: 0.93rem;
  font-weight: 700;
  margin-bottom: 5px;
}
.blk-tip > p { color: #a8d5c2; margin: 0; }

