/* ================================================================
   rich-content.css  — Dark Mode Edition
   Reproduit pixel-perfect le style de l'éditeur admin_course.php
   en version dark pour module.php
   ================================================================ */

/* ── Zone de contenu ─────────────────────────────────────────── */
.chapter-rich-content,
.module-rich-content {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  font-size: 14px;
  line-height: 1.75;
  color: #e2e8f0;
}
.chapter-rich-content *,
.module-rich-content * { box-sizing: border-box; }

.chapter-rich-content p,
.module-rich-content p { color: #c9d1d9; margin: 0 0 0.9em; }

.chapter-rich-content ul,
.chapter-rich-content ol,
.module-rich-content ul,
.module-rich-content ol { padding-left: 1.5em; margin-bottom: 0.9em; color: #c9d1d9; }

.chapter-rich-content li,
.module-rich-content li { margin-bottom: 0.4em; }

.chapter-rich-content strong,
.module-rich-content strong { color: #e2e8f0; }

.chapter-rich-content h4,
.module-rich-content h4 { color: #00d4ff; font-size: 1.05rem; margin: 1.1em 0 0.5em; }

.chapter-rich-content h6,
.module-rich-content h6 { color: #8896a7; font-size: 0.88rem; margin: 0.8em 0 0.3em; font-weight: 600; }

/* ================================================================
   🃏 CARTE  .blk-card
   Fond sombre avec bordure bleue, titre cyan — miroir dark du blanc
================================================================ */
.blk-card {
  background: rgba(13, 110, 253, 0.07);
  border: 1px solid rgba(0, 212, 255, 0.22);
  border-radius: 12px;
  padding: 16px 18px;
  margin: 12px 0;
  color: #e2e8f0;
  display: block;
  position: relative;
  overflow: hidden;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.blk-card:hover {
  border-color: rgba(0, 212, 255, 0.45);
  box-shadow: 0 4px 18px rgba(0, 212, 255, 0.1);
}
.blk-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, #0d6efd, #00d4ff);
}
.blk-card > strong {
  display: block;
  color: #6ea8fe;
  font-size: 0.96rem;
  font-weight: 700;
  margin-bottom: 8px;
}
.blk-card > p { color: #c9d1d9; margin: 0; }

/* ================================================================
   📐 GRILLES  .blk-grid2 / .blk-grid3
================================================================ */
.blk-grid2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  margin: 14px 0;
}
.blk-grid3 {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12px;
  margin: 14px 0;
}
.blk-grid2 > .blk-card,
.blk-grid3 > .blk-card { margin: 0; }

@media (max-width: 768px) {
  .blk-grid2,
  .blk-grid3 { grid-template-columns: 1fr; }
}

/* ================================================================
   🚨 ALERTES — bordure gauche colorée, fond teinté
================================================================ */

