.blk-danger > p { color: #d4a0a5; margin: 0; }

/* ℹ️ Info — bleu */
.blk-info {
  background: rgba(13, 110, 253, 0.07);
  border-left: 4px solid #0d6efd;
  border-top: none; border-right: none; border-bottom: none;
  border-radius: 0 12px 12px 0;
  padding: 14px 18px;
  margin: 12px 0;
  display: block;
}
.blk-info > strong {
  display: block;
  color: #6ea8fe;
