  background: rgba(255, 193, 7, 0.07);
  border-left: 4px solid #ffc107;
  border-top: none; border-right: none; border-bottom: none;
  border-radius: 0 12px 12px 0;
  padding: 14px 18px;
  margin: 12px 0;
  display: block;
}
.blk-warning > strong {
  display: block;
  color: #ffc107;
  font-size: 0.93rem;
  font-weight: 700;
